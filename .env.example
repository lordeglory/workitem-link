# Fine-grained token or classic PAT with Administration: write on the repo.
# Needed only for: node src/apply-protection.js --apply
GITHUB_TOKEN=

# Target repo for the legacy branch protection rule
GITHUB_OWNER=lordeglory
GITHUB_REPO=workitem
GITHUB_BRANCH=main

# Status check name. Must match the job name in .github/workflows/workitem-policy.yml
CHECK_NAME=Work item linked

# Optional: fail the check unless AB# ids exist in Azure Boards
ADO_ORGANIZATION=
ADO_PROJECT=
ADO_PAT=
